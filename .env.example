# Nome da imobiliária/empresa exibido na mensagem inicial.
AGENT_COMPANY_NAME="A&L Negócios Imobiliários"

# Nome do consultor/SDR que assina a mensagem (aparece em *negrito* no WhatsApp).
AGENT_SIGNATURE_NAME="Linhares"

# Cargo/função do consultor, exibido logo após o nome ("Aqui é o *Linhares*, <AGENT_ROLE> da ...").
AGENT_ROLE="corretor de imóveis e gestor de negócios"

# Código do país usado quando o telefone da planilha não inclui DDI (ex: 55 = Brasil).
DEFAULT_COUNTRY_CODE=55

# Caminho do CSV com os contatos (colunas: name, phone, consent).
CONTACTS_FILE=data/contacts.csv

# Onde o estado da conversa de cada contato é persistido entre execuções.
STATE_FILE=data/state.json

# Fila de leads que precisam de atendimento humano (interesse detectado ou resposta ambígua).
HANDOFF_QUEUE_FILE=data/handoff-queue.json

# Pasta onde a sessão autenticada do WhatsApp Web fica salva (evita escanear o QR toda vez).
WHATSAPP_SESSION_PATH=.wwebjs_auth

# Intervalo aleatório (ms) entre o envio de mensagens para diferentes contatos.
MESSAGE_MIN_DELAY_MS=8000
MESSAGE_MAX_DELAY_MS=20000

# Número (apenas dígitos, com DDI) de um time/consultor interno que recebe o aviso de
# handoff quando um lead demonstra interesse. Deixe em branco para desativar a notificação.
HANDOFF_NOTIFY_NUMBER=

# Painel web (QR code + upload de contatos). Por padrão só aceita acesso da própria máquina.
# Só mude DASHBOARD_HOST para 0.0.0.0 se souber o que está fazendo (expõe na rede local).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000

# Se definido, o painel passa a exigir ?token=SEU_TOKEN na URL (ou header X-Dashboard-Token).
# Recomendado caso DASHBOARD_HOST seja alterado para aceitar acesso de outros dispositivos.
DASHBOARD_TOKEN=

# Abre o painel no navegador automaticamente ao iniciar. Defina como false em servidores
# sem interface gráfica (ex.: quando rodando como serviço systemd).
AUTO_OPEN_BROWSER=true

# ---------------- Ads Studio (painel de tráfego pago com agentes de IA) ----------------

# Chave da API da Claude (Anthropic) — necessária apenas para os agentes de IA e o
# gerador de criativos. Crie em https://platform.claude.com. Sem ela, o painel
# funciona normalmente (produtos, imagens, campanhas e playbooks), só sem IA.
ANTHROPIC_API_KEY=

# Modelo usado pelos agentes. claude-opus-4-8 é o padrão (melhor qualidade).
# Para gastar menos por resposta, use claude-haiku-4-5 (mais barato e rápido).
CLAUDE_MODEL=claude-opus-4-8

# Limites de tokens por resposta (controle de custo).
CLAUDE_CHAT_MAX_TOKENS=1500
CLAUDE_GEN_MAX_TOKENS=3000

# Endereço do painel Ads Studio (npm run ads).
ADS_HOST=127.0.0.1
ADS_PORT=3010

# ---------------- Imóvel IA (assistente de busca de imóveis no site) ----------------

# Modelo do assistente do site (volume alto → Haiku recomendado; qualidade máxima → claude-opus-4-8).
CLAUDE_MODEL_IMOVEIS=claude-haiku-4-5
IMOVEL_IA_MAX_TOKENS=1200

# Identidade exibida no chat e usada no contexto da IA.
IMOVEL_IA_EMPRESA="A&L Negócios Imobiliários"
IMOVEL_IA_CIDADES="Itajaí e região"

# WhatsApp da equipe (apenas dígitos, com DDD; DDI 55 é adicionado sozinho).
IMOVEL_IA_WHATSAPP=

# Token para proteger o painel /admin (recomendado ao expor na internet).
IMOVEL_IA_ADMIN_TOKEN=

# Endereço do servidor do assistente (npm run imoveis). Em produção, use 0.0.0.0 atrás de HTTPS.
IMOVEL_IA_HOST=127.0.0.1
IMOVEL_IA_PORT=3020
